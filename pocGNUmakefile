# Build the example programs with poc, the Peaseblossom Oberon Compiler, as
# installed (poc on PATH, with its runtime library poc-rtl):
#
#   make -f pocGNUmakefile
#
# poc builds in poc-build/, where the sources it needs are symlinked, for
# two reasons. What it writes - each module's .sym (in text), .ll and .o,
# and the programs - lands there and not next to the sources, where it
# would overwrite voc's symbol files (voc then ignores them, "warning 306
# inappropriate symbol file ignored", until they are rebuilt). And poc does
# not see what voc leaves here: it compiles a Module.c beside Module.Mod as
# the module's part in C, which voc's generated ArgParser.c is not.
#
# Args and Err come from poc-rtl, so Err.Mod here (the voc version) is not
# linked into poc-build/.
#
# The programs take ArgParser from the library built in poc-build/lib/, so
# the tests test this checkout and what make install would install.
#
# make -f pocGNUmakefile install installs the library argparser in
# $(POCLIBDIR), ~/.local/lib/poc by default, for each variant: a size model,
# with or without debug information. poc puts each in <triple>/<variant>/
# there. A module a library on the library path has is never compiled, so
# other repos' programs don't compile ArgParser again. Err.Mod isn't
# installed: poc has its own.
#
# POC selects another poc, by an absolute path, since it runs in poc-build:
#
#   make -f pocGNUmakefile POC=$HOME/Repos/Oberon/Peaseblossom/build/bin/poc

POC ?= poc
PREFIX ?= $(HOME)/.local
POCLIBDIR ?= $(PREFIX)/lib/poc
MODELS ?= O2 OC
VARIANTS := $(MODELS) $(addsuffix -g,$(MODELS))

# An installed library on POC_LIBRARY_PATH would be taken in place of this
# checkout's source, or would stop the build if another poc wrote it.
unexport POC_LIBRARY_PATH

LIBRARY = argparser
MODULES = ArgParser
BUILDDIR = poc-build
LIBDIR = $(BUILDDIR)/lib
PROGRAMS = Simple Commands OneName Folded

# $(call variant-flags,<variant>) gives poc's flags for a variant: O2-g gives
# -O2 -g.
variant-flags = -$(firstword $(subst -, ,$(1))) $(if $(filter %-g,$(1)),-g)

# A library records the poc that built it, and another poc refuses it, so
# each library depends on poc itself.
POCBIN := $(shell command -v $(POC))

.PHONY: all clean test-poc test-verbose install uninstall

# Keep the symlinks to the sources instead of deleting them as intermediates.
.SECONDARY:

all: $(addprefix $(BUILDDIR)/,$(PROGRAMS))

$(BUILDDIR):
	mkdir -p $@

$(BUILDDIR)/%.Mod: %.Mod | $(BUILDDIR)
	ln -sf ../$< $@

# Built in poc-build/lib/, away from voc's ArgParser.c.
$(LIBDIR)/$(LIBRARY)-%.stamp: $(MODULES:%=$(BUILDDIR)/%.Mod) $(POCBIN)
	mkdir -p $(LIBDIR)
	cd $(BUILDDIR) && $(POC) $(call variant-flags,$*) -output-dir lib -library $(LIBRARY) $(MODULES:%=%.Mod)
	touch $@

$(BUILDDIR)/%: $(BUILDDIR)/%.Mod $(LIBDIR)/$(LIBRARY)-O2.stamp
	cd $(BUILDDIR) && $(POC) -library-path lib -o $* $*.Mod

# Run the fixtures in tests/ against the poc-built programs and report how
# many passed and failed; test-verbose announces each test as it goes.
test-poc: all
	BINDIR=$(BUILDDIR) ./tests/run-tests.sh

test-verbose: all
	BINDIR=$(BUILDDIR) ./tests/run-tests.sh -v

# install copies the library, in each variant, into $(POCLIBDIR) with poc
# -install-library, which copies only what a program needs: the archive, the
# shared object, the manifest, and each module's .sym and .owner (not the .o
# and .ll that -library also writes). A program then finds it with
# -library-path $(POCLIBDIR). A library records the poc that built it, and
# another poc refuses it: install again after upgrading poc.
define newline


endef

install: $(foreach v,$(VARIANTS),$(LIBDIR)/$(LIBRARY)-$(v).stamp)
	$(foreach v,$(VARIANTS),$(POC) $(call variant-flags,$(v)) \
	  -library-path $(LIBDIR) -install-library $(LIBRARY) -output-dir $(POCLIBDIR)$(newline))

# uninstall removes from $(POCLIBDIR)/<triple>/<variant> what install put
# there. It leaves other libraries' files alone, and removes a directory only
# when nothing is left in it. The triple is poc's target.
INSTALLED_FILES := $(LIBRARY).library lib$(LIBRARY).a lib$(LIBRARY).so lib$(LIBRARY).so.0.0 \
  $(foreach m,$(MODULES),$(m).sym $(m).owner)

uninstall:
	@triple=$$($(POC) -version | sed -n 's/^target \([^ ]*\).*/\1/p'); \
	if [ -z "$$triple" ]; then echo "uninstall: cannot get the target from $(POC) -version" >&2; exit 1; fi; \
	for v in $(VARIANTS); do \
	  dir=$(POCLIBDIR)/$$triple/$$v; \
	  if [ -d "$$dir" ]; then \
	    echo "cd $$dir && rm -f $(INSTALLED_FILES)"; \
	    (cd "$$dir" && rm -f $(INSTALLED_FILES)) || exit 1; \
	    rmdir "$$dir" 2>/dev/null || :; \
	  fi; \
	done; \
	rmdir $(POCLIBDIR)/$$triple 2>/dev/null || :; \
	rmdir $(POCLIBDIR) 2>/dev/null || :

clean:
	-rm -rfv $(BUILDDIR)
